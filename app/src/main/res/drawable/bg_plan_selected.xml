<?xml version="1.0" encoding="utf-8"?>
<!--
  Rim behind the centred card. The 4dp margin on the card itself is what leaves
  this visible; the transformer fades it in as a page reaches the centre.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FFFDF6FF"
        android:endColor="#FFBFD9FF"
        android:startColor="#FFE3C9FF"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
