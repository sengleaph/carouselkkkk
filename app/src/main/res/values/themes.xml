<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MySub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MySub" parent="Base.Theme.MySub" />

    <!--
      The upgrade sheet is a BottomSheetDialogFragment. The dialog background is
      cleared so the rounded panel in the sheet layout (bg_sheet) is what shows;
      leaving the Material background in place would draw a second, square-ish
      surface behind it. enableEdgeToEdge lets Material pad the sheet for the
      navigation bar itself.
    -->
    <style name="ThemeOverlay.MySub.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MySub.BottomSheet</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.MySub.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="behavior_fitToContents">true</item>
        <!--
          Material would pad the *container* for the navigation bar, which stops
          the white panel short of the screen edge. The panel takes the inset as
          its own padding instead — see UpgradePlanBottomSheet.applyInsets.
        -->
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>
</resources>
