<?xml version="1.0" encoding="utf-8"?>
<!--
  Root is a plain FrameLayout so ViewPager2's page transformer can scale it.
  selectionGlow sits *behind* the card and is revealed by the transformer as the
  page approaches centre — that keeps the highlight smooth without rebinding.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/selectionGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_plan_selected" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/planCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/plan_card_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/planArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:background="@drawable/bg_plan_purple" />

            <ImageView
                android:id="@+id/ivPlanIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_gift_box" />

            <LinearLayout
                android:id="@+id/priceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="10dp"
                android:background="@drawable/bg_price_label"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/tvPlanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/plan_title_gold"
                    android:textSize="11sp"
                    tools:text="Daily" />

                <TextView
                    android:id="@+id/tvPlanPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="$12.00" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
