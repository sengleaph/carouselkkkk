<?xml version="1.0" encoding="utf-8"?>
<!--
  One carousel page.

  Root is a plain FrameLayout so ViewPager2's page transformer can scale and
  translate it freely. The card face is a single asset: pinbase.png already
  carries the rounded corners, the white rim, the light burst and the gift box,
  so there is no card view, no artwork layer and no gift icon here: only the
  artwork and the price pill that sits over its empty lower third.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      fitXY, not fitCenter: the page box is sized by the carousel maths and is a
      few percent off the asset's 180:241, and stretching that little is less
      visible than letterboxing the card away from the price pill.
    -->
    <ImageView
        android:id="@+id/planArtwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/pinbase" />

    <LinearLayout
        android:id="@+id/priceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_price_label"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/tvPlanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/plan_title_gold"
            android:textSize="10sp"
            tools:text="Daily" />

        <TextView
            android:id="@+id/tvPlanPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="$12.00" />
    </LinearLayout>
</FrameLayout>
